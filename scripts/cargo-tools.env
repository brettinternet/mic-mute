# Exact versions of the build tools installed with `cargo install --locked`.
# Taskfile.dist.yaml loads this file (dotenv) and scripts/install.sh sources it;
# their checks compare the installed binary's --version, so a bump reinstalls.
CARGO_BUNDLE_VERSION=0.12.0
APPLE_CODESIGN_VERSION=0.29.0
TOML_CLI_VERSION=0.2.3
WATCHEXEC_CLI_VERSION=2.8.0
